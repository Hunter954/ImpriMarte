<%- include('partials/head',{title}) %><%- include('partials/header') %>
<% const gallery = Array.isArray(product.gallery) ? product.gallery : []; const productImages = [product.image_path, ...gallery].filter(Boolean); %>
<main class="container page-space">
  <div class="product-detail">
    <div class="product-gallery">
      <div class="detail-image" data-product-main>
        <% if(productImages.length){ %><img src="<%= productImages[0] %>" alt="<%= product.name %>" data-main-product-image><% } else { %><div class="image-placeholder big"><img class="placeholder-logo" src="<%= settings.site_logo_path || '/img/logo.png' %>" alt="ImpriMarte"></div><% } %>
      </div>
      <% if(productImages.length > 1){ %><div class="product-thumbs" aria-label="Fotos do produto"><% productImages.forEach((img,index)=>{ %><button type="button" class="product-thumb <%= index===0?'active':'' %>" data-product-thumb="<%= img %>" aria-label="Ver foto <%= index+1 %>"><img src="<%= img %>" alt="Foto <%= index+1 %> de <%= product.name %>"></button><% }) %></div><% } %>
    </div>
    <div class="detail-copy"><span class="eyebrow"><%= product.category_name || 'PERSONALIZADO' %></span><h1><%= product.name %></h1><p><%= product.description || product.short_description %></p><div class="detail-price"><%= product.price_from ? 'A partir de ' + formatBRL(product.price_from) : 'Preço sob consulta' %></div><p class="muted">O valor final pode variar conforme quantidade, tamanho, material e acabamento.</p><label>Quantidade estimada<input id="qty" class="qty-input" type="number" value="1" min="1"></label><label>Observação<textarea id="note" placeholder="Ex.: 100 unidades, logo colorida, tamanho 5x5cm"></textarea></label><div class="detail-actions"><button id="addProduct" class="btn" data-product='<%- JSON.stringify({id:product.id,name:product.name,slug:product.slug,price:product.price_from,image:product.image_path}) %>'><i class="bi bi-bag-plus"></i> Adicionar ao carrinho</button><button id="quoteProduct" class="btn btn-outline" data-name="<%= product.name %>"><i class="bi bi-whatsapp"></i> Pedir orçamento no WhatsApp</button></div></div>
  </div>
  <% if(related.length){ %><section class="section-block"><div class="section-head"><h2>Você também pode gostar</h2></div><div class="product-grid"><% related.forEach(product => { %><%- include('partials/product-card',{product}) %><% }) %></div></section><% } %>
</main>
<script>
document.querySelectorAll('[data-product-thumb]').forEach(btn=>btn.addEventListener('click',()=>{const main=document.querySelector('[data-main-product-image]');if(!main)return;main.src=btn.dataset.productThumb;document.querySelectorAll('[data-product-thumb]').forEach(item=>item.classList.remove('active'));btn.classList.add('active')}));
</script>
<%- include('partials/footer') %>
