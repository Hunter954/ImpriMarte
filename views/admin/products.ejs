<%- include('_head',{title}) %><div class="toolbar"><p>Gerencie os itens exibidos no catálogo.</p><a class="admin-btn" href="/admin/produtos/novo">+ Novo produto</a></div><div class="admin-card table-wrap"><table><thead><tr><th>Produto</th><th>Categoria</th><th>Preço inicial</th><th>Status</th><th></th></tr></thead><tbody><% products.forEach(p=>{ %><tr><td><div class="product-cell"><% if(p.image_path){%><img src="<%= p.image_path %>"><%}%><div><strong><%= p.name %></strong><small>/<%= p.slug %></small></div></div></td><td><%= p.category_name || '—' %></td><td><%= p.price_from ? formatBRL(p.price_from) : 'Sob consulta' %></td><td><span class="badge <%= p.active?'on':'off' %>"><%= p.active?'Ativo':'Inativo' %></span></td><td class="actions"><a href="/admin/produtos/<%= p.id %>/editar">Editar</a><form method="post" action="/admin/produtos/<%= p.id %>/excluir" onsubmit="return confirm('Excluir este produto?')"><button>Excluir</button></form></td></tr><% }) %></tbody></table></div><%- include('_foot') %>
