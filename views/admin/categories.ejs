<%- include('_head',{title}) %>
<% const iconOptions = [
['grid','Grade'],['sticky','Adesivo'],['journal-bookmark','Caderno'],['gift','Presente'],['house-heart','Casa'],['palette','Arte'],['balloon','Festa'],['tag','Etiqueta'],['box-seam','Caixa'],['cup-hot','Caneca'],['star','Estrela'],['heart','Coração'],['briefcase','Corporativo'],['camera','Foto'],['image','Imagem'],['printer','Impressão'],['file-earmark-text','Papel'],['card-text','Cartão'],['layers','Camadas'],['collection','Coleção'],['shop','Loja']
]; %>
<div class="page-intro categories-page-intro">
  <div><h2>Categorias do catálogo</h2><p>Crie as categorias principais e entre em cada uma para gerenciar quantas subcategorias precisar.</p></div>
</div>

<div class="categories-workspace">
  <section class="admin-card form-section category-create-panel">
    <div class="section-title"><span class="section-icon"><i class="bi bi-plus-square"></i></span><div><h3>Nova categoria</h3><p>O endereço da página é criado automaticamente a partir do nome.</p></div></div>
    <form method="post" class="stack-form category-create-form">
      <label><span>Nome da categoria</span><input name="name" required placeholder="Ex.: Fotos"></label>
      <div class="two-fields">
        <label><span>Ícone Bootstrap</span><div class="icon-picker-field"><span class="icon-live-preview"><i class="bi bi-grid"></i></span><input name="icon" value="grid" data-icon-value readonly><button type="button" class="icon-picker-button" data-icon-picker-open>Escolher</button></div></label>
        <label><span>Ordem</span><input name="sort_order" type="number" value="0"><small>Menor número aparece primeiro.</small></label>
      </div>
      <label class="switch-row"><div><strong>Categoria ativa</strong><small>Exibir no site</small></div><span class="switch"><input name="active" type="checkbox" checked><i></i></span></label>
      <button class="admin-btn" type="submit"><i class="bi bi-plus-lg"></i> Adicionar categoria</button>
    </form>
  </section>

  <section class="category-cards-area">
    <div class="category-section-heading"><div><span class="card-kicker">ESTRUTURA DO CATÁLOGO</span><h3>Categorias cadastradas</h3></div><span class="count-badge"><%= categories.length %> categorias</span></div>
    <% if(!categories.length){ %><div class="admin-card empty-admin"><i class="bi bi-tags"></i><h4>Nenhuma categoria</h4><p>Crie a primeira categoria ao lado.</p></div><% } %>
    <div class="category-cards-grid">
      <% categories.forEach(c=>{ const iconClass = c.icon && c.icon.startsWith('bi-') ? c.icon : `bi-${c.icon || 'grid'}`; %>
        <article class="admin-card category-overview-card">
          <div class="category-overview-top">
            <span class="category-card-icon"><i class="bi <%= iconClass %>"></i></span>
            <span class="status-pill <%= c.active?'active':'inactive' %>"><%= c.active?'Ativa':'Inativa' %></span>
          </div>
          <div class="category-overview-copy"><h3><%= c.name %></h3><p><strong><%= c.subcategory_count %></strong> subcategoria(s) · <strong><%= c.product_count %></strong> produto(s)</p></div>
          <div class="category-overview-actions">
            <a class="admin-btn compact" href="/admin/categorias/<%= c.id %>"><i class="bi bi-diagram-3"></i> Gerenciar</a>
            <form method="post" action="/admin/categorias/<%= c.id %>/excluir"><button class="icon-action danger" type="submit" data-inline-confirm="Excluir a categoria “<%= c.name %>”? As subcategorias também serão removidas e os produtos ficarão sem categoria." title="Excluir"><i class="bi bi-trash3"></i></button></form>
          </div>
        </article>
      <% }) %>
    </div>
  </section>
</div>

<div class="icon-picker-modal" data-icon-picker-modal aria-hidden="true"><div class="icon-picker-backdrop" data-icon-picker-close></div><div class="icon-picker-dialog"><div class="icon-picker-head"><div><span class="card-kicker">BOOTSTRAP ICONS</span><h3>Escolha um ícone</h3><p>Selecione visualmente o ícone da categoria.</p></div><button type="button" class="icon-action" data-icon-picker-close><i class="bi bi-x-lg"></i></button></div><div class="icon-search"><i class="bi bi-search"></i><input type="search" placeholder="Buscar por nome..." data-icon-search></div><div class="icon-options-grid"><% iconOptions.forEach(([value,label])=>{ %><button type="button" class="icon-option" data-icon-option="<%= value %>" data-icon-label="<%= label.toLowerCase() %> <%= value %>"><i class="bi bi-<%= value %>"></i><span><%= label %></span><small><%= value %></small></button><% }) %></div></div></div>
<%- include('_foot') %>
