<%- include('_head',{title}) %><div class="admin-two"><form class="admin-card" method="post"><h2>Nova categoria</h2><label>Nome<input name="name" required></label><label>Slug<input name="slug"></label><label>Ícone (nome livre)<input name="icon" value="grid"></label><label>Ordem<input name="sort_order" type="number" value="0"></label><label class="check"><input name="active" type="checkbox" checked> Ativa</label><button class="admin-btn">Adicionar</button></form><div class="admin-card"><h2>Categorias</h2><div class="category-admin-list"><% categories.forEach(c=>{ %><form method="post" action="/admin/categorias/<%= c.id %>/editar" class="category-row"><input name="name" value="<%= c.name %>"><input name="slug" value="<%= c.slug %>"><input name="icon" value="<%= c.icon %>"><input name="sort_order" type="number" value="<%= c.sort_order %>"><label><input name="active" type="checkbox" <%= c.active?'checked':'' %>> ativa</label><button>Salvar</button></form><form method="post" action="/admin/categorias/<%= c.id %>/excluir" onsubmit="return confirm('Excluir categoria? Os produtos ficarão sem categoria.')"><button class="danger">Excluir</button></form><hr><% }) %></div></div></div><%- include('_foot') %>
