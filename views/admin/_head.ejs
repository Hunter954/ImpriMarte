<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <meta name="theme-color" content="#15110f">
  <title><%= title %> | Painel ImpriMarte</title>
  <link rel="icon" href="<%= adminSettings?.favicon_path || adminSettings?.site_logo_path || '/img/logo.png' %>">
  <link rel="preconnect" href="https://cdn.jsdelivr.net">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/css/admin.css?v=20260919-3">
</head>
<body>
<div class="admin-shell" id="adminShell">
  <aside class="admin-sidebar" id="adminSidebar">
    <div class="sidebar-top">
      <a class="admin-brand" href="/admin" aria-label="ImpriMarte - Painel">
        <img src="<%= adminSettings?.site_logo_path || '/img/logo.png' %>" alt="ImpriMarte">
      </a>
      <button class="sidebar-close" type="button" data-sidebar-close aria-label="Fechar menu"><i class="bi bi-x-lg"></i></button>
    </div>

    <div class="sidebar-caption">GESTÃO</div>
    <nav class="admin-nav">
      <a class="<%= adminPath === '/' ? 'active' : '' %>" href="/admin"><i class="bi bi-grid-1x2-fill"></i><span>Visão geral</span></a>
      <a class="<%= adminPath.startsWith('/produtos') ? 'active' : '' %>" href="/admin/produtos"><i class="bi bi-box-seam-fill"></i><span>Produtos</span></a>
      <a class="<%= adminPath.startsWith('/categorias') ? 'active' : '' %>" href="/admin/categorias"><i class="bi bi-tags-fill"></i><span>Categorias</span></a>
      <a class="<%= adminPath.startsWith('/banners') ? 'active' : '' %>" href="/admin/banners"><i class="bi bi-images"></i><span>Banners</span></a>
    </nav>

    <div class="sidebar-caption">SITE</div>
    <nav class="admin-nav">
      <a class="<%= adminPath.startsWith('/configuracoes') ? 'active' : '' %>" href="/admin/configuracoes"><i class="bi bi-sliders2"></i><span>Configurações</span></a>
      <a href="/" target="_blank" rel="noopener"><i class="bi bi-box-arrow-up-right"></i><span>Visualizar site</span></a>
    </nav>

    <div class="sidebar-user">
      <div class="sidebar-avatar"><i class="bi bi-person-fill"></i></div>
      <div><strong><%= adminName %></strong><small>Administrador</small></div>
      <form method="post" action="/admin/logout"><button type="submit" title="Sair"><i class="bi bi-box-arrow-right"></i></button></form>
    </div>
  </aside>
  <div class="admin-backdrop" data-sidebar-close></div>

  <section class="admin-main">
    <header class="admin-topbar">
      <div class="topbar-left">
        <button class="mobile-admin-toggle" type="button" data-sidebar-open aria-label="Abrir menu"><i class="bi bi-list"></i></button>
        <div><span class="topbar-kicker">Painel administrativo</span><h1><%= title %></h1></div>
      </div>
      <div class="topbar-actions">
        <a class="topbar-icon" href="/" target="_blank" title="Abrir site"><i class="bi bi-eye"></i></a>
        <a class="admin-btn compact" href="/admin/produtos/novo"><i class="bi bi-plus-lg"></i><span>Novo produto</span></a>
      </div>
    </header>
    <main class="admin-content">
      <% if (notice) { %><div class="alert success auto-dismiss"><i class="bi bi-check-circle-fill"></i><span><%= notice %></span><button type="button" data-alert-close><i class="bi bi-x"></i></button></div><% } %>
