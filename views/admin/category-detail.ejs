<%- include('_head',{title}) %>
<% const iconOptions = [
['grid','Grade'],['sticky','Adesivo'],['journal-bookmark','Caderno'],['gift','Presente'],['house-heart','Casa'],['palette','Arte'],['balloon','Festa'],['tag','Etiqueta'],['box-seam','Caixa'],['cup-hot','Caneca'],['star','Estrela'],['heart','Coração'],['briefcase','Corporativo'],['camera','Foto'],['images','Fotos'],['image','Imagem'],['printer','Impressão'],['file-earmark-text','Papel'],['card-text','Cartão'],['layers','Camadas'],['collection','Coleção'],['shop','Loja']
]; const currentIcon=category.icon&&category.icon.startsWith('bi-')?category.icon.replace(/^bi-/,''):(category.icon||'grid'); %>
<div class="page-intro sticky-intro">
  <div>
    <div class="breadcrumb-admin"><a href="/admin/categorias">Categorias</a><i class="bi bi-chevron-right"></i><span><%= category.name %></span></div>
    <p class="page-intro-note">Edite a categoria usada no catálogo e na navegação do site.</p>
  </div>
  <a class="admin-btn ghost" href="/admin/categorias"><i class="bi bi-arrow-left"></i> Voltar</a>
</div>

<div class="category-detail-simple">
  <section class="admin-card form-section">
    <div class="section-title"><span class="section-icon"><i class="bi bi-tag"></i></span><div><h3>Editar categoria</h3><p>O endereço da página é atualizado automaticamente pelo sistema.</p></div></div>
    <form method="post" action="/admin/categorias/<%= category.id %>/editar" class="stack-form">
      <label><span>Nome</span><input name="name" value="<%= category.name %>" required></label>
      <div class="two-fields">
        <label><span>Ícone Bootstrap</span><div class="icon-picker-field"><span class="icon-live-preview"><i class="bi bi-<%= currentIcon %>"></i></span><input name="icon" value="<%= currentIcon %>" data-icon-value readonly><button type="button" class="icon-picker-button" data-icon-picker-open>Escolher</button></div></label>
        <label><span>Ordem</span><input name="sort_order" type="number" value="<%= category.sort_order %>"><small>Menor número aparece primeiro.</small></label>
      </div>
      <div class="category-edit-summary"><i class="bi bi-box-seam"></i><span><strong><%= category.product_count %></strong> produto(s) vinculados a esta categoria.</span></div>
      <label class="switch-row"><div><strong>Categoria ativa</strong><small>Visível para clientes</small></div><span class="switch"><input name="active" type="checkbox" <%= category.active?'checked':'' %>><i></i></span></label>
      <button class="admin-btn" type="submit"><i class="bi bi-check2"></i> Salvar categoria</button>
    </form>
  </section>
</div>

<div class="icon-picker-modal" data-icon-picker-modal aria-hidden="true"><div class="icon-picker-backdrop" data-icon-picker-close></div><div class="icon-picker-dialog"><div class="icon-picker-head"><div><span class="card-kicker">BOOTSTRAP ICONS</span><h3>Escolha um ícone</h3><p>Selecione visualmente o ícone da categoria.</p></div><button type="button" class="icon-action" data-icon-picker-close><i class="bi bi-x-lg"></i></button></div><div class="icon-search"><i class="bi bi-search"></i><input type="search" placeholder="Buscar por nome..." data-icon-search></div><div class="icon-options-grid"><% iconOptions.forEach(([value,label])=>{ %><button type="button" class="icon-option" data-icon-option="<%= value %>" data-icon-label="<%= label.toLowerCase() %> <%= value %>"><i class="bi bi-<%= value %>"></i><span><%= label %></span><small><%= value %></small></button><% }) %></div></div></div>
<%- include('_foot') %>
