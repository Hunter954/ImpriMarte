<%- include('_head',{title}) %>
<section class="page-intro">
  <div>
    <div class="breadcrumb-admin"><a href="/admin/orcamentos">Orçamentos</a><i class="bi bi-chevron-right"></i><span>Regras</span></div>
    <h2>Regras do calculador</h2>
    <p>O cálculo usa a boca útil da impressora e o comprimento linear realmente ocupado.</p>
  </div>
</section>
<form method="post" class="quote-settings-grid">
  <section class="admin-card quote-section">
    <div class="card-head"><div><span class="card-kicker">MÁQUINA</span><h3>Área de produção</h3></div></div>
    <div class="two-fields">
      <label class="stack-label"><span>Largura da folha A3 (cm)</span><input type="number" step="0.1" min="1" name="quote_sheet_width_cm" value="<%= config.sheetWidth %>" required></label>
      <label class="stack-label"><span>Altura da folha A3 (cm)</span><input type="number" step="0.1" min="1" name="quote_sheet_height_cm" value="<%= config.sheetHeight %>" required></label>
      <label class="stack-label"><span>Boca útil da impressora (cm)</span><input type="number" step="0.1" min="1" name="quote_max_print_width_cm" value="<%= config.maxPrintWidth %>" required></label>
      <label class="stack-label"><span>Espaço entre adesivos (cm)</span><input type="number" step="0.01" min="0" name="quote_spacing_cm" value="<%= config.spacing %>" required><small>Use 0 enquanto quiser calcular sem folga entre peças.</small></label>
    </div>
  </section>

  <section class="admin-card quote-section">
    <div class="card-head"><div><span class="card-kicker">COM RECORTE</span><h3>Preço por comprimento</h3></div></div>
    <div class="two-fields">
      <label class="stack-label"><span>Preço por metro</span><div class="money-field"><span>R$</span><input type="number" step="0.01" min="0.01" name="quote_cut_linear_meter_price" value="<%= config.cutLinearMeterPrice %>" required></div></label>
      <label class="stack-label"><span>Valor mínimo</span><div class="money-field"><span>R$</span><input type="number" step="0.01" min="0.01" name="quote_minimum_cut_price" value="<%= config.minimumCutPrice %>" required></div></label>
    </div>
  </section>

  <section class="admin-card quote-section">
    <div class="card-head"><div><span class="card-kicker">SEM RECORTE</span><h3>Preço por comprimento</h3></div></div>
    <div class="two-fields">
      <label class="stack-label"><span>Preço por metro</span><div class="money-field"><span>R$</span><input type="number" step="0.01" min="0.01" name="quote_no_cut_linear_meter_price" value="<%= config.noCutLinearMeterPrice %>" required></div></label>
      <label class="stack-label"><span>Valor mínimo</span><div class="money-field"><span>R$</span><input type="number" step="0.01" min="0.01" name="quote_minimum_no_cut_price" value="<%= config.minimumNoCutPrice %>" required></div></label>
    </div>
  </section>

  <div class="quote-settings-actions"><a class="admin-btn ghost" href="/admin/orcamentos">Cancelar</a><button class="admin-btn" type="submit"><i class="bi bi-check2"></i> Salvar regras</button></div>
</form>
<%- include('_foot') %>
