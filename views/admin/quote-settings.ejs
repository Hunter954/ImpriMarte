<%- include('_head',{title}) %>
<section class="page-intro">
  <div>
    <div class="breadcrumb-admin"><a href="/admin/orcamentos">Orçamentos</a><i class="bi bi-chevron-right"></i><span>Configurações</span></div>
    <h2>Regras do cálculo</h2>
    <p>Esses valores alimentam a calculadora em tempo real. A fórmula usa a largura útil da máquina e o comprimento linear necessário.</p>
  </div>
  <div class="intro-actions"><a class="admin-btn ghost" href="/admin/orcamentos"><i class="bi bi-arrow-left"></i> Voltar</a></div>
</section>
<% if (saved) { %><div class="alert success"><i class="bi bi-check-circle-fill"></i><span>Regras de orçamento atualizadas com sucesso.</span></div><% } %>

<form method="post" action="/admin/orcamentos/configuracoes" class="admin-card quote-settings-form">
  <div class="card-head">
    <div>
      <span class="card-kicker">MÁQUINA E PREÇOS</span>
      <h3>Configurações da calculadora</h3>
    </div>
  </div>
  <div class="quote-settings-grid">
    <label class="stack-label"><span>Largura da A3 (cm)</span><input type="number" name="sheet_width" min="1" step="0.1" value="<%= config.sheetWidth %>" required></label>
    <label class="stack-label"><span>Altura da A3 (cm)</span><input type="number" name="sheet_height" min="1" step="0.1" value="<%= config.sheetHeight %>" required></label>
    <label class="stack-label"><span>Boca útil da impressora (cm)</span><input type="number" name="max_print_width" min="1" step="0.1" value="<%= config.maxPrintWidth %>" required></label>
    <label class="stack-label"><span>Espaçamento entre adesivos (cm)</span><input type="number" name="spacing" min="0" step="0.1" value="<%= config.spacing %>" required></label>
    <label class="stack-label"><span>Preço por metro com recorte (R$)</span><input type="number" name="cut_linear_meter_price" min="0" step="0.01" value="<%= config.cutLinearMeterPrice %>" required></label>
    <label class="stack-label"><span>Preço por metro sem recorte (R$)</span><input type="number" name="no_cut_linear_meter_price" min="0" step="0.01" value="<%= config.noCutLinearMeterPrice %>" required></label>
    <label class="stack-label"><span>Valor mínimo com recorte (R$)</span><input type="number" name="minimum_cut_price" min="0" step="0.01" value="<%= config.minimumCutPrice %>" required></label>
    <label class="stack-label"><span>Valor mínimo sem recorte (R$)</span><input type="number" name="minimum_no_cut_price" min="0" step="0.01" value="<%= config.minimumNoCutPrice %>" required></label>
  </div>
  <div class="form-actions quote-settings-actions">
    <button class="admin-btn" type="submit"><i class="bi bi-check2-circle"></i> Salvar regras</button>
  </div>
</form>
<%- include('_foot') %>
