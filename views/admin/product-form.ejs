<%- include('_head',{title}) %><form class="admin-card form-grid" method="post" enctype="multipart/form-data"><label>Nome<input name="name" value="<%= product?.name || '' %>" required></label><label>Slug<input name="slug" value="<%= product?.slug || '' %>" placeholder="deixe vazio para gerar"></label><label>Categoria<select name="category_id"><option value="">Sem categoria</option><% categories.forEach(c=>{ %><option value="<%= c.id %>" <%= product?.category_id===c.id?'selected':'' %>><%= c.name %></option><% }) %></select></label><label>Preço a partir de<input name="price_from" type="number" step="0.01" min="0" value="<%= product?.price_from || '' %>" placeholder="deixe vazio para sob consulta"></label><label class="full">Descrição curta<input name="short_description" value="<%= product?.short_description || '' %>"></label><label class="full">Descrição<textarea name="description" rows="6"><%= product?.description || '' %></textarea></label><label>Imagem<input name="image" type="file" accept="image/png,image/jpeg,image/webp,image/gif"></label><label>Ordem<input name="sort_order" type="number" value="<%= product?.sort_order || 0 %>"></label><label class="check"><input type="checkbox" name="featured" <%= product?.featured?'checked':'' %>> Destacar na home</label><label class="check"><input type="checkbox" name="active" <%= product? (product.active?'checked':'') : 'checked' %>> Produto ativo</label><div class="full form-actions"><a href="/admin/produtos">Cancelar</a><button class="admin-btn">Salvar produto</button></div></form><%- include('_foot') %>
