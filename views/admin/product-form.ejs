<%- include('_head',{title}) %>
<div class="page-intro sticky-intro">
  <div class="breadcrumb-admin"><a href="/admin/produtos">Produtos</a><i class="bi bi-chevron-right"></i><span><%= product ? 'Editar' : 'Novo produto' %></span></div>
  <div class="intro-actions"><a class="admin-btn ghost" href="/admin/produtos"><i class="bi bi-arrow-left"></i> Voltar</a><button class="admin-btn" type="submit" form="productForm"><i class="bi bi-check2"></i> Salvar produto</button></div>
</div>

<form id="productForm" class="editor-layout" method="post" enctype="multipart/form-data">
  <div class="editor-main">
    <section class="admin-card form-section">
      <div class="section-title"><span class="section-icon"><i class="bi bi-box-seam"></i></span><div><h3>Informações do produto</h3><p>Dados principais exibidos no catálogo e na página do produto.</p></div></div>
      <div class="form-grid professional product-info-grid">
        <label class="full"><span>Nome do produto <b>*</b></span><input name="name" value="<%= product?.name || '' %>" required placeholder="Ex.: Caneca personalizada"></label>
        <label class="full"><span>Categoria</span><select name="category_id"><option value="">Sem categoria</option><% categories.forEach(c=>{ %><option value="<%= c.id %>" <%= String(product?.category_id)===String(c.id)?'selected':'' %>><%= c.name %></option><% }) %></select><small>Escolha a categoria principal. Os filtros do catálogo serão criados automaticamente pelas especificações cadastradas abaixo.</small></label>
        <label class="full"><span>Descrição curta</span><input name="short_description" maxlength="180" value="<%= product?.short_description || '' %>" placeholder="Uma frase objetiva para os cards do catálogo"></label>
        <div class="full rich-editor-field" data-rich-editor>
          <span class="rich-editor-label">Descrição completa</span>
          <div class="rich-editor-toolbar" role="toolbar" aria-label="Formatação da descrição">
            <button type="button" data-editor-command="bold" title="Negrito"><i class="bi bi-type-bold"></i></button>
            <button type="button" data-editor-command="italic" title="Itálico"><i class="bi bi-type-italic"></i></button>
            <span class="editor-divider"></span>
            <button type="button" data-editor-block="h3" title="Título"><i class="bi bi-type-h3"></i></button>
            <button type="button" data-editor-block="p" title="Parágrafo"><i class="bi bi-text-paragraph"></i></button>
            <span class="editor-divider"></span>
            <button type="button" data-editor-command="insertUnorderedList" title="Lista com marcadores"><i class="bi bi-list-ul"></i></button>
            <button type="button" data-editor-command="insertOrderedList" title="Lista numerada"><i class="bi bi-list-ol"></i></button>
            <button type="button" data-editor-link title="Inserir link"><i class="bi bi-link-45deg"></i></button>
            <button type="button" data-editor-command="removeFormat" title="Limpar formatação"><i class="bi bi-eraser"></i></button>
          </div>
          <div class="rich-editor-area" contenteditable="true" data-editor-area data-placeholder="Descreva materiais, opções de personalização, tamanhos e informações importantes..."><%- product?.description || '' %></div>
          <textarea name="description" data-editor-input hidden><%= product?.description || '' %></textarea>
          <small>Use negrito, listas, subtítulos e links para deixar a descrição mais organizada e fácil de ler.</small>
        </div>
      </div>
    </section>

    <section class="admin-card form-section product-specs-editor">
      <div class="section-title specs-title"><span class="section-icon"><i class="bi bi-list-check"></i></span><div><h3>Especificações do produto</h3><p>Cadastre material, formato, acabamento e outras características. Essas informações também geram automaticamente os filtros da página Todos os produtos.</p></div></div>
      <% const specifications = Array.isArray(product?.specifications) ? product.specifications : []; %>
      <div class="spec-editor-head" aria-hidden="true"><span>Nome da informação</span><span>Valor</span><span></span></div>
      <div class="spec-editor-list" data-spec-list>
        <% (specifications.length ? specifications : [{label:'',value:''}]).forEach((spec,index)=>{ %>
          <div class="spec-editor-row" data-spec-row>
            <label><span class="mobile-field-label">Informação</span><input type="text" name="spec_label" value="<%= spec.label || '' %>" placeholder="Ex.: Material" maxlength="80"></label>
            <label><span class="mobile-field-label">Valor</span><input type="text" name="spec_value" value="<%= spec.value || '' %>" placeholder="Ex.: Premium 210g" maxlength="180"></label>
            <button type="button" class="icon-action danger spec-remove" data-spec-remove title="Remover linha" aria-label="Remover especificação"><i class="bi bi-trash3"></i></button>
          </div>
        <% }) %>
      </div>
      <div class="spec-editor-footer"><button type="button" class="admin-btn ghost" data-spec-add><i class="bi bi-plus-lg"></i> Adicionar especificação</button><small>Você pode adicionar até 30 especificações por produto.</small></div>
    </section>

    <section class="admin-card form-section">
      <div class="section-title"><span class="section-icon"><i class="bi bi-image"></i></span><div><h3>Imagem principal</h3><p>É a primeira foto que aparece no catálogo e na página do produto.</p></div></div>
      <div class="media-uploader">
        <div class="media-preview" data-image-preview>
          <% if(product?.image_path){ %><img src="<%= product.image_path %>" alt="Imagem atual"><% } else { %><div class="media-empty"><i class="bi bi-cloud-arrow-up"></i><strong>Selecione uma imagem</strong><span>PNG, JPG, WEBP ou GIF até 8 MB</span></div><% } %>
        </div>
        <div class="media-controls"><label class="upload-btn"><i class="bi bi-upload"></i> Escolher imagem<input name="image" type="file" accept="image/png,image/jpeg,image/webp,image/gif" data-image-input hidden></label><small>Recomendado: imagem quadrada, com boa iluminação.</small><% if(product?.image_path){ %><label class="check danger-check"><input type="checkbox" name="remove_image"> Remover imagem atual</label><% } %></div>
      </div>
    </section>

    <section class="admin-card form-section">
      <div class="section-title"><span class="section-icon"><i class="bi bi-images"></i></span><div><h3>Galeria de fotos</h3><p>Adicione até 8 fotos extras. No site elas aparecem como miniaturas abaixo da imagem principal.</p></div></div>
      <% const gallery = Array.isArray(product?.gallery) ? product.gallery : []; %>
      <% if(gallery.length){ %>
        <div class="admin-gallery-grid">
          <% gallery.forEach((img,index)=>{ %><label class="admin-gallery-item"><img src="<%= img %>" alt="Foto extra <%= index+1 %>"><span><input type="checkbox" name="remove_gallery" value="<%= img %>"> Remover</span></label><% }) %>
        </div>
      <% } %>
      <label class="gallery-upload-zone">
        <i class="bi bi-images"></i><div><strong>Adicionar fotos extras</strong><small>Selecione várias imagens de uma vez. Máximo de 8 fotos na galeria.</small></div>
        <input name="gallery" type="file" accept="image/png,image/jpeg,image/webp,image/gif" multiple data-gallery-input hidden>
        <span class="admin-btn ghost"><i class="bi bi-plus-lg"></i> Selecionar imagens</span>
      </label>
      <div class="new-gallery-preview" data-gallery-preview></div>
    </section>
  </div>

  <aside class="editor-side">
    <section class="admin-card form-section side-card">
      <div class="section-title compact-title"><span class="section-icon"><i class="bi bi-cash-coin"></i></span><div><h3>Preço</h3></div></div>
      <label><span>Preço a partir de</span><div class="money-field"><span>R$</span><input name="price_from" inputmode="decimal" value="<%= product?.price_from || '' %>" placeholder="0,00"></div><small>Deixe em branco para exibir “Sob consulta”.</small></label>
    </section>

    <section class="admin-card form-section side-card">
      <div class="section-title compact-title"><span class="section-icon"><i class="bi bi-broadcast"></i></span><div><h3>Publicação</h3></div></div>
      <label class="switch-row"><div><strong>Produto ativo</strong><small>Visível no catálogo</small></div><span class="switch"><input type="checkbox" name="active" <%= product ? (product.active?'checked':'') : 'checked' %>><i></i></span></label>
      <label class="switch-row"><div><strong>Destacar na home</strong><small>Aparece em produtos em destaque</small></div><span class="switch"><input type="checkbox" name="featured" <%= product?.featured?'checked':'' %>><i></i></span></label>
      <label class="stack-label"><span>Ordem de exibição</span><input name="sort_order" type="number" value="<%= product?.sort_order || 0 %>"><small>Menor número aparece primeiro.</small></label>
    </section>

    <% if(product){ %><section class="admin-card form-section side-card danger-zone"><h3>Zona de risco</h3><p>A exclusão é permanente e remove o item do catálogo.</p><button type="button" class="danger-button" data-submit-confirm="deleteProduct"><i class="bi bi-trash3"></i> Excluir produto</button></section><% } %>
  </aside>
</form>
<% if(product){ %><form id="deleteProduct" method="post" action="/admin/produtos/<%= product.id %>/excluir" data-confirm="Excluir “<%= product.name %>”? Esta ação não pode ser desfeita."></form><% } %>
<%- include('_foot') %>
