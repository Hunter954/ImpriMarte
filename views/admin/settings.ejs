<%- include('_head',{title}) %><% if(saved){ %><div class="alert success">Configurações salvas.</div><% } %><form class="admin-card form-grid" method="post"><label>Nome do site<input name="site_name" value="<%= settings.site_name || '' %>"></label><label>WhatsApp (DDI+DDD+número)<input name="whatsapp_number" value="<%= settings.whatsapp_number || '' %>" placeholder="5545999999999"></label><label class="full">Chamada pequena do topo<input name="hero_kicker" value="<%= settings.hero_kicker || '' %>"></label><label class="full">Título principal<input name="hero_title" value="<%= settings.hero_title || '' %>"></label><label class="full">Texto principal<textarea name="hero_text"><%= settings.hero_text || '' %></textarea></label><label class="full">Texto sobre<textarea name="about_text" rows="5"><%= settings.about_text || '' %></textarea></label><label>Instagram<input name="instagram_url" value="<%= settings.instagram_url || '' %>"></label><label>Facebook<input name="facebook_url" value="<%= settings.facebook_url || '' %>"></label><label>TikTok<input name="tiktok_url" value="<%= settings.tiktok_url || '' %>"></label><label>Rodapé<input name="footer_note" value="<%= settings.footer_note || '' %>"></label><div class="full form-actions"><button class="admin-btn">Salvar configurações</button></div></form><%- include('_foot') %>
