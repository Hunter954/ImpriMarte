<%- include('_head',{title}) %><div class="admin-two"><form class="admin-card" method="post" enctype="multipart/form-data"><h2>Novo banner</h2><label>Título<input name="title" required></label><label>Subtítulo<input name="subtitle"></label><label>Texto do botão<input name="button_text"></label><label>Link do botão<input name="button_link" placeholder="/produtos"></label><label>Imagem<input type="file" name="image" accept="image/*"></label><label>Ordem<input name="sort_order" type="number" value="0"></label><label class="check"><input name="active" type="checkbox" checked> Ativo</label><button class="admin-btn">Adicionar</button></form><div class="admin-card"><h2>Banners cadastrados</h2><% if(!banners.length){ %><p>Nenhum banner extra cadastrado.</p><% } %><% banners.forEach(b=>{ %><div class="banner-row"><% if(b.image_path){ %><img src="<%= b.image_path %>"><% } %><div><strong><%= b.title %></strong><small><%= b.subtitle %></small></div><form method="post" action="/admin/banners/<%= b.id %>/excluir" onsubmit="return confirm('Excluir banner?')"><button class="danger">Excluir</button></form></div><% }) %></div></div><%- include('_foot') %>
