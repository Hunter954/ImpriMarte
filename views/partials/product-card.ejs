<article class="product-card">
  <button class="fav-btn" data-favorite="<%= product.id %>" aria-label="Favoritar">♡</button>
  <a href="/produto/<%= product.slug %>" class="product-image">
    <% if(product.image_path){ %><img src="<%= product.image_path %>" alt="<%= product.name %>"><% } else { %><div class="image-placeholder"><span>Impri</span><b>Marte</b></div><% } %>
  </a>
  <div class="product-info"><a href="/produto/<%= product.slug %>"><h3><%= product.name %></h3></a><p><%= product.short_description || '' %></p><strong><%= product.price_from ? 'A partir de ' + formatBRL(product.price_from) : 'Sob consulta' %></strong>
  <button class="btn btn-small add-cart" data-product='<%- JSON.stringify({id:product.id,name:product.name,slug:product.slug,price:product.price_from,image:product.image_path}) %>'>Adicionar</button></div>
</article>
