<header class="site-header">
  <div class="header-main container">
    <button class="icon-btn mobile-only menu-btn" id="menuToggle" aria-label="Abrir menu"><i class="bi bi-list"></i></button>
    <a href="/" class="brand"><img src="/img/logo.png" alt="ImpriMarte"></a>
    <form class="search desktop-only" action="/produtos" method="get">
      <input name="q" placeholder="O que você deseja personalizar?" value="<%= typeof q !== 'undefined' ? q : '' %>">
      <button aria-label="Buscar"><i class="bi bi-search"></i></button>
    </form>
    <div class="header-actions">
      <a class="desktop-only header-text-link" href="/contato"><i class="bi bi-headset"></i><span>Atendimento</span></a>
      <a class="icon-btn" href="/produtos" aria-label="Buscar"><i class="bi bi-search"></i></a>
      <a class="cart-link icon-btn" href="/carrinho" aria-label="Carrinho"><i class="bi bi-bag"></i><span data-cart-count>0</span></a>
    </div>
  </div>
  <nav class="main-nav" id="mainNav">
    <div class="container nav-scroll">
      <a href="/produtos"><i class="bi bi-grid"></i> Todos os produtos</a>
      <% navCategories.slice(0,7).forEach(cat => { %><a href="/categoria/<%= cat.slug %>"><%= cat.name %></a><% }) %>
      <a href="/sobre">Sobre</a>
      <a href="/contato">Contato</a>
    </div>
  </nav>
</header>
