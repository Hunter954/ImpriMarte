<%- include('partials/head',{title}) %><%- include('partials/header') %>
<main class="container page-space">
  <div class="page-hero"><span class="eyebrow">CATEGORIA</span><h1><%= category.name %></h1><p>Confira todos os produtos disponíveis nesta categoria.</p></div>
  <div class="product-grid product-grid-wide"><% products.forEach(product => { %><%- include('partials/product-card',{product}) %><% }) %></div>
  <% if(!products.length){ %><div class="empty-category"><i class="bi bi-box-seam"></i><h3>Nenhum produto nesta categoria</h3><p>Em breve teremos novidades por aqui.</p></div><% } %>
</main>
<%- include('partials/footer') %>
